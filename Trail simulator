-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

-- Attend que le personnage soit chargé
player.CharacterAdded:Connect(function(character)
    character:WaitForChild("HumanoidRootPart")
end)

-- Attend ItemSpawners avec un timeout de 10 secondes
local ITEM_SPAWNERS = Workspace:WaitForChild("ItemSpawners", 10)
if not ITEM_SPAWNERS then warn("ItemSpawners introuvable !") return end

-- Attend Cosmic avec un timeout de 10 secondes
local COSMIC_PART = ITEM_SPAWNERS:WaitForChild("Cosmic", 10)
if not COSMIC_PART then warn("Cosmic introuvable !") return end

-- Fonction pour trouver un ProximityPrompt
local function findProximityPrompt(model)
    if not model then return nil end
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("ProximityPrompt") then
            return child
        end
    end
    return nil
end

-- Fonction pour collecter un brainrot
local function collectBrainrot(brainrotModel)
    if not brainrotModel then return end

    -- Trouve la PrimaryPart
    local primaryPart = brainrotModel.PrimaryPart or brainrotModel:FindFirstChild("Mesh") or brainrotModel:FindFirstChild("Base")
    if not primaryPart then
        warn("Pas de PrimaryPart pour : " .. brainrotModel.Name)
        return
    end

    -- Trouve le ProximityPrompt
    local proximityPrompt = findProximityPrompt(brainrotModel)
    if not proximityPrompt then
        warn("Aucun ProximityPrompt trouvé dans : " .. brainrotModel.Name)
        return
    end

    -- Téléporte le joueur
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.CFrame = primaryPart.CFrame + Vector3.new(0, 3, 0)
        wait(0.2) -- Petit délai pour que le joueur soit bien positionné
    end

    -- Active le ProximityPrompt
    proximityPrompt:InputHoldBegin()
    wait(0.5)
    proximityPrompt:InputHoldEnd()

    print("Brainrot " .. brainrotModel.Name .. " collecté.")
end

-- Fonction pour collecter tous les brainrots
local function collectAllCosmicBrainrots()
    if not COSMIC_PART then return end

    for _, brainrotModel in ipairs(COSMIC_PART:GetChildren()) do
        if brainrotModel:IsA("Model") then
            collectBrainrot(brainrotModel)
            wait(1) -- Délai entre chaque collecte
        end
    end
end

