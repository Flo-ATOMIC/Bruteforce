-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

-- Récupère le joueur local
local player = Players.LocalPlayer

-- Attend que le personnage du joueur soit chargé
player.CharacterAdded:Connect(function(character)
    character:WaitForChild("HumanoidRootPart")
end)

-- Attend que la Part "Cosmic" existe dans ItemSpawner
local ITEM_SPAWNER = Workspace:WaitForChild("ItemSpawner")
local COSMIC_PART = ITEM_SPAWNER:WaitForChild("Cosmic")

-- Fonction pour trouver un ProximityPrompt dans un modèle
local function findProximityPrompt(model)
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("ProximityPrompt") then
            return child
        end
    end
    return nil
end

-- Fonction pour collecter un brainrot
local function collectBrainrot(brainrotModel)
    -- Trouve la PrimaryPart
    local primaryPart = brainrotModel.PrimaryPart
    if not primaryPart then
        primaryPart = brainrotModel:FindFirstChild("Mesh") or brainrotModel:FindFirstChild("Base")
    end

    if not primaryPart then
        warn("Le modèle " .. brainrotModel.Name .. " n'a pas de PrimaryPart.")
        return
    end

    -- Trouve le ProximityPrompt
    local proximityPrompt = findProximityPrompt(brainrotModel)
    if not proximityPrompt then
        warn("Aucun ProximityPrompt trouvé dans " .. brainrotModel.Name)
        return
    end

    -- Téléporte le joueur local vers le brainrot
    local character = player.Character
    if character then
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoidRootPart then
            humanoidRootPart.CFrame = primaryPart.CFrame + Vector3.new(0, 3, 0)
        end
    end

    -- Active le ProximityPrompt localement
    proximityPrompt:InputHoldBegin()
    wait(0.5)
    proximityPrompt:InputHoldEnd()

    print("Brainrot " .. brainrotModel.Name .. " collecté localement.")
end

-- Fonction pour collecter tous les brainrots enfants de la Part Cosmic
local function collectAllCosmicBrainrots()
    for _, brainrotModel in ipairs(COSMIC_PART:GetChildren()) do
        if brainrotModel:IsA("Model") then
            collectBrainrot(brainrotModel)
            wait(1) -- Délai pour éviter les bugs
        end
    end
end

