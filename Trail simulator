-- Gestion des clics
local isCollecting = false

collectButton.MouseEnter:Connect(function()
    if not isCollecting then
        collectButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    end
end)

collectButton.MouseLeave:Connect(function()
    if isCollecting then
        collectButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
    else
        collectButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
    end
end)

collectButton.MouseButton1Click:Connect(function()
    if isCollecting then
        collectButton.Text = "Collecter les Brainrots"
        statusLabel.Text = "Prêt à collecter"
        collectButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
        isCollecting = false
    else
        collectButton.Text = "Arrêter la collecte"
        statusLabel.Text = "Collecte en cours..."
        collectButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        isCollecting = true
        
        -- Lance la collecte en tâche de fond pour ne pas figer l'interface
        task.spawn(function()
            collectAllCosmicBrainrots()
            if isCollecting then -- Remet le bouton à zéro une fois terminé
                collectButton.Text = "Collecter les Brainrots"
                statusLabel.Text = "Prêt à collecter"
                collectButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
                isCollecting = false
            end
        end)
    end
end)
