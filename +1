local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

-- Attend que le personnage soit chargé
player.CharacterAdded:Connect(function(character)
    character:WaitForChild("HumanoidRootPart")
end)

-- Attend ItemSpawners avec un timeout de 10 secondes
local WINS_BUTTONS = Workspace:WaitForChild("WinsButtons", 10)
if not WINS_BUTTONS then warn("WinsButtons introuvable !") return end

-- Fonction pour trouver un ProximityPrompt
local function findProximityPrompt(model)
    if not model then return nil end
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("ProximityPrompt") then
            return child
        end
    end
    return nil
end
-- Fonction pour collecter un brainrot (retourne true si succès, false si échec/inventaire plein)
local function collectBrainrot(brainrotModel)
    if not brainrotModel then return false end

    local primaryPart = brainrotModel.PrimaryPart or brainrotModel:FindFirstChild("Mesh") or brainrotModel:FindFirstChild("Base")
    if not primaryPart then return false end

    local proximityPrompt = findProximityPrompt(brainrotModel)
    if not proximityPrompt then return false end

    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.CFrame = primaryPart.CFrame + Vector3.new(0, 3, 0)
        wait(0.2) 
    end

    proximityPrompt:InputHoldBegin()
    wait(0.5)
    proximityPrompt:InputHoldEnd()

    -- Vérification cruciale : est-ce que le brainrot a bien disparu ?
    wait(0.2) -- Laisse le temps au serveur de traiter la demande
    if brainrotModel.Parent == COSMIC_PART then
        -- Le modèle est toujours là, donc la collecte a échoué (inventaire plein)
        return false 
    else
        print("Brainrot " .. brainrotModel.Name .. " collecté.")
        return true
    end
end

